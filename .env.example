# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=fintech_user
DB_PASSWORD=fintech_password
DB_NAME=fintech_personal

# Database Synchronization
DISABLE_DB_SYNC=false  # Set to true to disable automatic database synchronization
RUN_MIGRATIONS=true    # Set to false to skip migrations on startup
RUN_SEEDS=false        # Set to true to run seeders on startup

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost
RABBITMQ_EXCHANGE=fintech.topic
RABBITMQ_EXCHANGE_TYPE=topic

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes
