# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=fintech_user
DB_PASSWORD=fintech_password
DB_NAME=fintech_personal
DB_SCHEMA=fintech  # Schema to use for all tables

# Database Synchronization
DISABLE_DB_SYNC=false  # Set to true to disable automatic database synchronization
RUN_MIGRATIONS=true    # Set to false to skip migrations on startup
RUN_SEEDS=false        # Set to true to run seeders on startup

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost
RABBITMQ_EXCHANGE=fintech.topic
RABBITMQ_EXCHANGE_TYPE=topic

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Email Configuration
EMAIL_HOST=smtp.mailtrap.io     # SMTP server host
EMAIL_PORT=2525                  # SMTP server port
EMAIL_USER=your_username         # SMTP server username
EMAIL_PASSWORD=your_password     # SMTP server password
EMAIL_SECURE=false               # Set to true for TLS/SSL
EMAIL_FROM=no-reply@fintechpersonal.com  # Default sender email
