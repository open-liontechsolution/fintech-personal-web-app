<%- include('partials/header', { title: 'Detalles de Cuenta', isAuthenticated: true }) %>

<div class="row mb-4">
  <div class="col-md-8">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/accounts">Cuentas</a></li>
        <li class="breadcrumb-item active" aria-current="page" id="account-name-breadcrumb">Detalles de Cuenta</li>
      </ol>
    </nav>
    <h1 id="account-name-title">Detalles de Cuenta</h1>
  </div>
  <div class="col-md-4 text-end">
    <button class="btn btn-outline-primary me-2" id="editAccountButton">
      <i class="bi bi-pencil"></i> Editar
    </button>
    <button class="btn btn-outline-secondary" id="addTransactionButton">
      <i class="bi bi-plus-lg"></i> Nueva Transacción
    </button>
  </div>
</div>

<div id="loading-spinner" class="text-center py-5">
  <div class="spinner-border text-primary" role="status">
    <span class="visually-hidden">Cargando...</span>
  </div>
</div>

<div id="error-message" class="alert alert-danger d-none" role="alert">
  <i class="bi bi-exclamation-triangle-fill"></i> Error al cargar la información de la cuenta.
</div>

<div id="account-details" class="d-none">
  <!-- Información general de la cuenta -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card shadow h-100" id="account-info-card">
        <div class="card-header">
          <h5 class="card-title mb-0">Información de Cuenta</h5>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-sm-4 text-muted">Tipo:</div>
            <div class="col-sm-8" id="account-type-display">--</div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-4 text-muted">Institución:</div>
            <div class="col-sm-8" id="account-institution-display">--</div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-4 text-muted">Número:</div>
            <div class="col-sm-8" id="account-number-display">--</div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-4 text-muted">Estado:</div>
            <div class="col-sm-8" id="account-status-display">--</div>
          </div>
          <div class="row mb-3">
            <div class="col-sm-4 text-muted">Notas:</div>
            <div class="col-sm-8 text-break" id="account-notes-display">--</div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-6">
      <div class="card shadow h-100">
        <div class="card-header">
          <h5 class="card-title mb-0">Balance</h5>
        </div>
        <div class="card-body text-center">
          <div class="display-1 mb-3" id="account-balance-display">--</div>
          <div class="text-muted">Última actualización: <span id="account-update-date">--</span></div>
          
          <hr class="my-4">
          
          <div class="row">
            <div class="col-6">
              <div class="text-success">
                <h5>Ingresos</h5>
                <div class="h3" id="total-income-display">--</div>
              </div>
            </div>
            <div class="col-6">
              <div class="text-danger">
                <h5>Gastos</h5>
                <div class="h3" id="total-expense-display">--</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Transacciones recientes -->
  <div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">Transacciones Recientes</h5>
      <a href="#" class="btn btn-sm btn-primary" id="view-all-transactions">Ver todas</a>
    </div>
    <div class="card-body">
      <div id="transactions-loading" class="text-center py-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status">
          <span class="visually-hidden">Cargando...</span>
        </div>
      </div>
      
      <div id="no-transactions-message" class="text-center py-4 d-none">
        <i class="bi bi-inbox-fill text-muted" style="font-size: 2rem;"></i>
        <h5 class="mt-3">No hay transacciones disponibles</h5>
        <p class="text-muted">Agrega transacciones a esta cuenta para llevar un seguimiento de tus movimientos</p>
        <button class="btn btn-primary mt-2" id="add-transaction-btn">Agregar Transacción</button>
      </div>
      
      <div id="transactions-container" class="d-none">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Descripción</th>
                <th>Categoría</th>
                <th class="text-end">Importe</th>
              </tr>
            </thead>
            <tbody id="transactions-table-body">
              <!-- Transactions will be loaded here -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript para cargar los datos de la cuenta específica -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const token = localStorage.getItem('auth_token');
  const accountId = '<%= accountId %>';
  
  // Si no hay token, redireccionar a login
  if (!token) {
    window.location.href = '/login';
    return;
  }

  // Elementos DOM
  const loadingSpinner = document.getElementById('loading-spinner');
  const errorMessage = document.getElementById('error-message');
  const accountDetails = document.getElementById('account-details');
  
  // Formateo de moneda
  const formatCurrency = (amount, currency = 'EUR') => {
    const currencyMap = {
      'EUR': { locale: 'es-ES', currency: 'EUR' },
      'USD': { locale: 'en-US', currency: 'USD' },
      'GBP': { locale: 'en-GB', currency: 'GBP' }
    };
    
    const { locale, currency: curr } = currencyMap[currency] || currencyMap['EUR'];
    
    return new Intl.NumberFormat(locale, { 
      style: 'currency', 
      currency: curr 
    }).format(amount);
  };

  // Formateo de fecha
  const formatDate = (dateString) => {
    const date = new Date(dateString);
    return new Intl.DateTimeFormat('es-ES', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    }).format(date);
  };

  // Cargar los detalles de la cuenta
  const loadAccountDetails = async () => {
    try {
      loadingSpinner.classList.remove('d-none');
      errorMessage.classList.add('d-none');
      accountDetails.classList.add('d-none');
      
      const response = await fetch(`/api/accounts/${accountId}`, {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });
      
      if (!response.ok) {
        throw new Error('Error al cargar los detalles de la cuenta');
      }
      
      const data = await response.json();
      const account = data.account;
      
      // Actualizar la información en la página
      document.getElementById('account-name-breadcrumb').textContent = account.name;
      document.getElementById('account-name-title').textContent = account.name;
      document.title = `${account.name} - Fintech Personal`;
      
      // Información de la cuenta
      document.getElementById('account-type-display').textContent = getAccountTypeLabel(account.type);
      document.getElementById('account-institution-display').textContent = account.institution || 'No especificada';
      document.getElementById('account-number-display').textContent = account.accountNumber ? 
        '•••• ' + account.accountNumber.slice(-4) : 'No especificado';
      
      const statusBadge = account.isActive ? 
        '<span class="badge bg-success">Activa</span>' : 
        '<span class="badge bg-secondary">Inactiva</span>';
      document.getElementById('account-status-display').innerHTML = statusBadge;
      
      document.getElementById('account-notes-display').textContent = account.notes || 'Sin notas';
      
      // Balance
      document.getElementById('account-balance-display').textContent = formatCurrency(account.balance, account.currency);
      document.getElementById('account-update-date').textContent = formatDate(account.updatedAt);
      
      // Aplicar el color de la cuenta al borde de la tarjeta de información
      if (account.color) {
        document.getElementById('account-info-card').style.borderLeft = `5px solid ${account.color}`;
      }
      
      // Cargar transacciones recientes
      loadTransactions();
      
      // Mostrar la información de la cuenta
      loadingSpinner.classList.add('d-none');
      accountDetails.classList.remove('d-none');
      
    } catch (error) {
      console.error('Error:', error);
      loadingSpinner.classList.add('d-none');
      errorMessage.classList.remove('d-none');
    }
  };

  // Cargar transacciones recientes de la cuenta
  const loadTransactions = async () => {
    try {
      const transactionsLoading = document.getElementById('transactions-loading');
      const noTransactionsMessage = document.getElementById('no-transactions-message');
      const transactionsContainer = document.getElementById('transactions-container');
      
      transactionsLoading.classList.remove('d-none');
      noTransactionsMessage.classList.add('d-none');
      transactionsContainer.classList.add('d-none');
      
      // Aquí se implementaría la llamada a la API para obtener las transacciones de la cuenta
      // Por ahora, mostraremos un mensaje de "sin transacciones"
      
      // Simular carga
      setTimeout(() => {
        transactionsLoading.classList.add('d-none');
        noTransactionsMessage.classList.remove('d-none');
        
        // Calcular ingresos y gastos simulados
        document.getElementById('total-income-display').textContent = formatCurrency(0);
        document.getElementById('total-expense-display').textContent = formatCurrency(0);
      }, 1000);
      
    } catch (error) {
      console.error('Error al cargar las transacciones:', error);
    }
  };

  // Obtener la etiqueta según el tipo de cuenta
  const getAccountTypeLabel = (type) => {
    const labels = {
      'checking': 'Cuenta Corriente',
      'savings': 'Cuenta de Ahorro',
      'credit': 'Tarjeta de Crédito',
      'investment': 'Cuenta de Inversión',
      'cash': 'Efectivo',
      'other': 'Otra'
    };
    
    return labels[type] || 'Otra';
  };

  // Botón de editar cuenta
  document.getElementById('editAccountButton').addEventListener('click', () => {
    window.location.href = `/accounts?edit=${accountId}`;
  });

  // Botón para agregar transacción
  document.getElementById('addTransactionButton').addEventListener('click', () => {
    window.location.href = `/transactions/new?account=${accountId}`;
  });
  
  document.getElementById('add-transaction-btn').addEventListener('click', () => {
    window.location.href = `/transactions/new?account=${accountId}`;
  });

  document.getElementById('view-all-transactions').addEventListener('click', (e) => {
    e.preventDefault();
    window.location.href = `/transactions?account=${accountId}`;
  });

  // Cargar los detalles de la cuenta al iniciar
  loadAccountDetails();
});
</script>

<%- include('partials/footer') %>
