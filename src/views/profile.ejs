<%- include('partials/header', { title: 'Mi Perfil', isAuthenticated: true }) %>

<div class="container py-4">
  <div class="row mb-4">
    <div class="col-md-12">
      <h1>Mi Perfil</h1>
    </div>
  </div>

  <div class="row">
    <!-- Profile information column -->
    <div class="col-md-4">
      <div class="card shadow mb-4">
        <div class="card-header">
          <h5 class="card-title mb-0">Información Personal</h5>
        </div>
        <div class="card-body">
          <div id="loading-profile" class="text-center py-3">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Cargando...</span>
            </div>
          </div>
          
          <div id="profile-details" class="d-none">
            <div class="mb-3">
              <label class="text-muted small">Nombre</label>
              <p class="fs-5 mb-1" id="profile-name"></p>
            </div>
            <div class="mb-3">
              <label class="text-muted small">Email</label>
              <p class="fs-5 mb-1" id="profile-email"></p>
            </div>
            <div class="mb-3">
              <label class="text-muted small">Fecha de registro</label>
              <p class="fs-5 mb-1" id="profile-created-at"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Invitations column -->
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0">Mis Invitaciones</h5>
          <button id="create-invitation-btn" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Crear invitación
          </button>
        </div>
        <div class="card-body">
          <div id="loading-invitations" class="text-center py-3">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Cargando...</span>
            </div>
          </div>
          
          <div id="invitation-details" class="d-none">
            <div class="alert alert-info mb-4">
              <div class="d-flex align-items-center">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <div>
                  <span id="invitation-limit-info">Puedes crear hasta <span id="invitation-limit">0</span> invitaciones</span>.
                  <br>
                  <span>Te quedan <strong id="remaining-invitations">0</strong> invitaciones disponibles.</span>
                </div>
              </div>
            </div>
            
            <div id="no-invitations-message" class="text-center py-4 d-none">
              <i class="bi bi-envelope-fill text-muted" style="font-size: 3rem;"></i>
              <h5 class="mt-3">No has creado ninguna invitación</h5>
              <p class="text-muted">Crea un código de invitación para que otros usuarios puedan registrarse</p>
            </div>
            
            <div id="invitations-table-container" class="d-none">
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Código</th>
                      <th>Fecha de creación</th>
                      <th>Expiración</th>
                      <th>Estado</th>
                      <th>Utilizado por</th>
                    </tr>
                  </thead>
                  <tbody id="invitations-table-body">
                    <!-- Invitations will be loaded here -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Invitation Modal -->
<div class="modal fade" id="create-invitation-modal" tabindex="-1" aria-labelledby="create-invitation-modal-label" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="create-invitation-modal-label">Crear nueva invitación</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="create-invitation-form">
          <div class="mb-3">
            <label for="expires-in-days" class="form-label">Expiración (días)</label>
            <input type="number" class="form-control" id="expires-in-days" min="1" max="90" value="30">
            <div class="form-text">La invitación expirará después de este número de días.</div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" id="submit-invitation" class="btn btn-primary">Crear invitación</button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const token = localStorage.getItem('auth_token');
  
  // If no token, redirect to login
  if (!token) {
    window.location.href = '/login';
    return;
  }
  
  // Initialize Bootstrap tooltips
  const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
  tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl)
  })
  
  // Format date
  const formatDate = (dateString) => {
    if (!dateString) return 'No expira';
    const date = new Date(dateString);
    return new Intl.DateTimeFormat('es-ES', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    }).format(date);
  };
  
  // Load user profile
  const loadProfile = async () => {
    try {
      const response = await fetch('/api/auth/me', {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });
      
      if (!response.ok) {
        throw new Error('Error loading user profile');
      }
      
      const data = await response.json();
      
      // Hide loading spinner
      document.getElementById('loading-profile').classList.add('d-none');
      
      // Show profile details
      document.getElementById('profile-details').classList.remove('d-none');
      
      // Update profile information
      document.getElementById('profile-name').textContent = data.user.name;
      document.getElementById('profile-email').textContent = data.user.email;
      document.getElementById('profile-created-at').textContent = formatDate(data.user.createdAt);
      
    } catch (error) {
      console.error('Error:', error);
      // Show error message
      document.getElementById('loading-profile').innerHTML = `
        <div class="alert alert-danger">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          Error al cargar el perfil
        </div>
      `;
    }
  };
  
  // Load user invitations
  const loadInvitations = async () => {
    try {
      const response = await fetch('/api/invitations', {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });
      
      if (!response.ok) {
        throw new Error('Error loading invitations');
      }
      
      const data = await response.json();
      
      // Hide loading spinner
      document.getElementById('loading-invitations').classList.add('d-none');
      
      // Show invitation details
      document.getElementById('invitation-details').classList.remove('d-none');
      
      // Update invitation limits
      document.getElementById('invitation-limit').textContent = data.invitationLimit;
      document.getElementById('remaining-invitations').textContent = data.remainingInvitations;
      
      // Enable/disable create invitation button based on remaining invitations
      const createInvitationBtn = document.getElementById('create-invitation-btn');
      if (data.remainingInvitations <= 0) {
        createInvitationBtn.disabled = true;
        createInvitationBtn.title = 'Has alcanzado el límite de invitaciones';
      }
      
      // Show invitations or no-invitations message
      if (data.invitationCodes.length === 0) {
        document.getElementById('no-invitations-message').classList.remove('d-none');
      } else {
        document.getElementById('invitations-table-container').classList.remove('d-none');
        
        const tableBody = document.getElementById('invitations-table-body');
        tableBody.innerHTML = '';
        
        data.invitationCodes.forEach(invitation => {
          const row = document.createElement('tr');
          
          // Determine status class
          const statusClass = invitation.isUsed ? 'text-success' : 
                             (invitation.expiresAt && new Date(invitation.expiresAt) < new Date() ? 'text-danger' : 'text-warning');
          
          // Determine status text
          const statusText = invitation.isUsed ? 'Utilizado' : 
                            (invitation.expiresAt && new Date(invitation.expiresAt) < new Date() ? 'Expirado' : 'Disponible');
          
          // Create table row
          row.innerHTML = `
            <td><code>${invitation.code}</code></td>
            <td>${formatDate(invitation.createdAt)}</td>
            <td>${invitation.expiresAt ? formatDate(invitation.expiresAt) : 'No expira'}</td>
            <td><span class="badge bg-${statusClass === 'text-success' ? 'success' : 
                                          statusClass === 'text-danger' ? 'danger' : 'warning'}">${statusText}</span></td>
            <td>${invitation.usedBy ? 
                  `${invitation.usedBy.name} (${invitation.usedBy.email})` : 
                  '-'}</td>
          `;
          
          tableBody.appendChild(row);
        });
      }
      
    } catch (error) {
      console.error('Error:', error);
      // Show error message
      document.getElementById('loading-invitations').innerHTML = `
        <div class="alert alert-danger">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          Error al cargar las invitaciones
        </div>
      `;
    }
  };
  
  // Create invitation
  const createInvitation = async (expiresInDays) => {
    try {
      const response = await fetch('/api/invitations', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ expiresInDays })
      });
      
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || 'Error creating invitation');
      }
      
      // Reload invitations
      loadInvitations();
      
      // Close modal
      const modal = bootstrap.Modal.getInstance(document.getElementById('create-invitation-modal'));
      modal.hide();
      
      // Show success message
      alert('Invitación creada correctamente');
      
    } catch (error) {
      console.error('Error:', error);
      alert(`Error: ${error.message}`);
    }
  };
  
  // Initialize create invitation modal
  const createInvitationBtn = document.getElementById('create-invitation-btn');
  createInvitationBtn.addEventListener('click', () => {
    const modal = new bootstrap.Modal(document.getElementById('create-invitation-modal'));
    modal.show();
  });
  
  // Handle create invitation form submission
  const submitInvitationBtn = document.getElementById('submit-invitation');
  submitInvitationBtn.addEventListener('click', () => {
    const expiresInDays = document.getElementById('expires-in-days').value;
    createInvitation(expiresInDays);
  });
  
  // Load data on page load
  loadProfile();
  loadInvitations();
});
</script>

<%- include('partials/footer') %>
